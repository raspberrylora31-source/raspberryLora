UART_PORT=/dev/serial0
UART_BAUD=38400

CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=360
CAMERA_FPS=15
PERSON_INFER_SIZE=320
WEAPON_INFER_SIZE=256
TARGET_INFERENCE_FPS=5

DETECTION_BACKEND=yolov5
PERSON_MODEL=models/yolov5n.pt
PERSON_CONFIDENCE_THRESHOLD=0.45

# Required for full detection. Must be a trained YOLOv5 weapon model.
WEAPON_MODEL=models/best.pt
WEAPON_CONFIDENCE_THRESHOLD=0.40
# Empty = use every non-person class from best.pt
# Example: WEAPON_CLASSES=weapon,pistol,rifle,gun
WEAPON_CLASSES=

CONFIRMATION_FRAMES=3
EVENT_COOLDOWN_SECONDS=10
ENABLE_DISPLAY=false
