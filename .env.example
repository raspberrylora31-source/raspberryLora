# Copy values into the shell or a process supervisor. All are optional.

UART_PORT=/dev/serial0
UART_BAUD=38400

CAMERA_INDEX=0
FRAME_WIDTH=640
FRAME_HEIGHT=360
CAMERA_FPS=15
INFER_SIZE=320
TARGET_INFERENCE_FPS=7

# yolo (YOLOv8n) or hog (OpenCV HOG, no neural-net weights)
DETECTION_BACKEND=yolo
PERSON_MODEL=models/yolov8n.pt
PERSON_CONFIDENCE_THRESHOLD=0.45

# Leave empty unless you supply a real weapon-class model file
WEAPON_MODEL=
WEAPON_CONFIDENCE_THRESHOLD=0.40
WEAPON_CLASSES=gun,pistol,rifle,weapon,firearm

CONFIRMATION_FRAMES=3
EVENT_COOLDOWN_SECONDS=30
STATE_CHANGE_ONLY=false

ENABLE_DISPLAY=false
