# Meshtastic PC Gateway — copy to .env and edit.
# Never commit .env. Never put passwords in the database.

# Local bind only by default. Do not use 0.0.0.0 unless you
# intentionally expose the gateway on a LAN (second-PC mode).
HOST=127.0.0.1
PORT=8000

GATEWAY_NAME=Meshtastic PC Gateway
GATEWAY_ID=pc-gateway-1

# Windows default for the user-tested T-Beam (CH9102). Change in Settings if needed.
COM_PORT=COM5

# Skip opening the radio (software tests / no hardware).
GATEWAY_SKIP_RADIO=false

# MQTT is disabled by default. First run does not require an MQTT library.
MQTT_ENABLED=false
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC_PREFIX=meshradio
